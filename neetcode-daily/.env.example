# Recipients (comma-separated) and from-address
DAILY_EMAIL_TO=you@example.com
DAILY_EMAIL_FROM=NeetDaily <neetdaily@yourdomain.com>

# Option A — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx

